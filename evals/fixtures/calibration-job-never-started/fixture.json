      "path": "src/services/stock.ts",
      "status": "modified",
      "additions": 30,
      "deletions": 0,
      "patch": "@@ -22,3 +22,33 @@\n   if (rows.length === 0) throw new Error(`cannot adjust ${sku}@${warehouse} by ${delta}`);\n   return rows[0].on_hand;\n }\n+\n+export interface Adjustment {\n+  sku: string;\n+  warehouse: string;\n+  delta: number;\n+}\n+\n+/** Applies every adjustment in one transaction: all of them, or none if any would go negative. */\n+export async function adjustStockBulk(db: Pool, adjustments: Adjustment[]): Promise<number[]> {\n+  const client = await db.connect();\n+  try {\n+    await client.query(\"begin\");\n+    const levels: number[] = [];\n+    for (const { sku, warehouse, delta } of adjustments) {\n+      const { rows } = await client.query(\n+        \"update stock set on_hand = on_hand + $3 where sku = $1 and warehouse = $2 and on_hand + $3 >= 0 returning on_hand\",\n+        [sku, warehouse, delta],\n+      );\n+      if (rows.length === 0) throw new Error(`cannot adjust ${sku}@${warehouse} by ${delta}`);\n+      levels.push(rows[0].on_hand);\n+    }\n+    await client.query(\"commit\");\n+    return levels;\n+  } catch (error) {\n+    await client.query(\"rollback\");\n+    throw error;\n+  } finally {\n+    client.release();\n+  }\n+}",
      "previousPath": null
    },
    {
      "path": "src/routes/stock.ts",
      "status": "modified",
      "additions": 12,
      "deletions": 1,
      "patch": "@@ -1,8 +1,14 @@\n import type { FastifyInstance } from \"fastify\";\n import { z } from \"zod\";\n-import { adjustStock, getStock } from \"../services/stock.js\";\n+import { adjustStock, adjustStockBulk, getStock } from \"../services/stock.js\";\n \n const adjustBody = z.object({ warehouse: z.string().min(1), delta: z.number().int() });\n+const bulkBody = z.object({\n+  adjustments: z\n+    .array(z.object({ sku: z.string().min(1), warehouse: z.string().min(1), delta: z.number().int() }))\n+    .min(1)\n+    .max(500),\n+});\n \n export async function stockRoutes(app: FastifyInstance): Promise<void> {\n   app.get<{ Params: { sku: string } }>(\"/v1/stock/:sku\", async (request) => getStock(app.db, request.params.sku));\n@@ -11,4 +17,9 @@\n     const { warehouse, delta } = adjustBody.parse(request.body);\n     return { onHand: await adjustStock(app.db, request.params.sku, warehouse, delta) };\n   });\n+\n+  app.post(\"/v1/stock/adjustments\", async (request) => {\n+    const { adjustments } = bulkBody.parse(request.body);\n+    return { onHand: await adjustStockBulk(app.db, adjustments) };\n+  });\n }",
      "previousPath": null
    },
    {
      "path": "test/routes/stock-bulk.test.ts",
      "status": "added",
      "additions": 29,
      "deletions": 0,
      "patch": "@@ -0,0 +1,29 @@\n+import { afterAll, beforeEach, describe, expect, it } from \"vitest\";\n+import { buildApp } from \"../../src/app.js\";\n+import { resetStock } from \"../helpers/db.js\";\n+\n+const app = await buildApp();\n+afterAll(() => app.close());\n+beforeEach(() => resetStock([{ sku: \"TSHIRT-M\", warehouse: \"mnl\", onHand: 10 }, { sku: \"CAP\", warehouse: \"mnl\", onHand: 2 }]));\n+\n+describe(\"POST /v1/stock/adjustments\", () => {\n+  it(\"applies every adjustment\", async () => {\n+    const res = await app.inject({\n+      method: \"POST\",\n+      url: \"/v1/stock/adjustments\",\n+      payload: { adjustments: [{ sku: \"TSHIRT-M\", warehouse: \"mnl\", delta: -3 }, { sku: \"CAP\", warehouse: \"mnl\", delta: 5 }] },\n+    });\n+    expect(res.json()).toEqual({ onHand: [7, 7] });\n+  });\n+\n+  it(\"applies none when one would go negative\", async () => {\n+    const res = await app.inject({\n+      method: \"POST\",\n+      url: \"/v1/stock/adjustments\",\n+      payload: { adjustments: [{ sku: \"TSHIRT-M\", warehouse: \"mnl\", delta: -3 }, { sku: \"CAP\", warehouse: \"mnl\", delta: -5 }] },\n+    });\n+    expect(res.statusCode).toBe(500);\n+    const after = await app.inject({ method: \"GET\", url: \"/v1/stock/TSHIRT-M\" });\n+    expect(after.json()[0].onHand).toBe(10);\n+  });\n+});",
      "previousPath": null
    }
