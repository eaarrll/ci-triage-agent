      "patch": "@@ -5,7 +5,7 @@\n from datetime import datetime\n from enum import Enum\n \n-from pydantic import BaseModel, Field, validator\n+from pydantic import BaseModel, ConfigDict, Field, field_validator\n \n \n class EntityType(str, Enum):\n@@ -15,22 +15,21 @@\n \n \n class FeatureValue(BaseModel):\n+    model_config = ConfigDict(from_attributes=True, frozen=True)\n+\n     name: str = Field(..., min_length=1, max_length=128)\n     value: float | int | str | None\n     computed_at: datetime\n \n-    class Config:\n-        orm_mode = True\n-        frozen = True\n \n-\n class FeatureVector(BaseModel):\n     entity_type: EntityType\n     entity_id: str\n     features: list[FeatureValue]\n     version: int = 1\n \n-    @validator(\"entity_id\")\n+    @field_validator(\"entity_id\")\n+    @classmethod\n     def _strip_entity_id(cls, v: str) -> str:\n         v = v.strip()\n         if not v:\n@@ -39,5 +38,5 @@\n \n     def as_row(self) -> dict[str, object]:\n         row: dict[str, object] = {f.name: f.value for f in self.features}\n-        row.update(self.dict(include={\"entity_type\", \"entity_id\", \"version\"}))\n+        row.update(self.model_dump(include={\"entity_type\", \"entity_id\", \"version\"}))\n         return row",
