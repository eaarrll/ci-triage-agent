  "changedFiles": [
    {
      "path": "src/billing/proration.ts",
      "status": "modified",
      "additions": 11,
      "deletions": 6,
      "patch": "@@ -1,3 +1,4 @@\n+import { DAY_MS } from \"../time.js\";\n import type { Plan, Subscription } from \"./types.js\";\n \n /**\n@@ -6,19 +7,23 @@\n  * the period, rounded half-up to the cent (see docs/billing.md).\n  */\n export function unusedCredit(sub: Subscription, changeAt: Date): number {\n-  return Math.round((sub.plan.priceCents * remainingMs(sub, changeAt)) / periodMs(sub));\n+  return Math.round((sub.plan.priceCents * remainingDays(sub, changeAt)) / periodDays(sub));\n }\n \n /** What the customer pays now when moving to `next` at `changeAt`, in cents. */\n export function upgradeCharge(sub: Subscription, next: Plan, changeAt: Date): number {\n-  const newCost = Math.round((next.priceCents * remainingMs(sub, changeAt)) / periodMs(sub));\n+  const newCost = Math.round((next.priceCents * remainingDays(sub, changeAt)) / periodDays(sub));\n   return Math.max(0, newCost - unusedCredit(sub, changeAt));\n }\n \n-function periodMs(sub: Subscription): number {\n-  return sub.periodEnd.getTime() - sub.periodStart.getTime();\n+/** Length of the billing period in days. */\n+export function periodDays(sub: Subscription): number {\n+  return Math.round((sub.periodEnd.getTime() - sub.periodStart.getTime()) / DAY_MS);\n }\n \n-function remainingMs(sub: Subscription, at: Date): number {\n-  return Math.min(periodMs(sub), Math.max(0, sub.periodEnd.getTime() - at.getTime()));\n+/** Days left in the period, for the invoice line (\"17 days remaining\"). */\n+export function remainingDays(sub: Subscription, at: Date): number {\n+  const periodMs = sub.periodEnd.getTime() - sub.periodStart.getTime();\n+  const remainingMs = Math.min(periodMs, Math.max(0, sub.periodEnd.getTime() - at.getTime()));\n+  return Math.floor(remainingMs / DAY_MS);\n }",
      "previousPath": null
    },
    {
      "path": "src/billing/invoice.ts",
      "status": "modified",
      "additions": 4,
      "deletions": 3,
      "patch": "@@ -1,13 +1,14 @@\n import type { InvoiceLine, Plan, Subscription } from \"./types.js\";\n-import { unusedCredit, upgradeCharge } from \"./proration.js\";\n+import { remainingDays, unusedCredit, upgradeCharge } from \"./proration.js\";\n \n /** Invoice lines for a plan change at `changeAt`. */\n export function planChangeLines(sub: Subscription, next: Plan, changeAt: Date): InvoiceLine[] {\n   const credit = unusedCredit(sub, changeAt);\n   const charge = upgradeCharge(sub, next, changeAt) + credit;\n+  const days = remainingDays(sub, changeAt);\n   return [\n-    { description: `Unused time on ${sub.plan.id}`, amountCents: -credit },\n-    { description: `Remaining time on ${next.id}`, amountCents: charge },\n+    { description: `Unused time on ${sub.plan.id} (${days} days remaining)`, amountCents: -credit },\n+    { description: `Remaining time on ${next.id} (${days} days remaining)`, amountCents: charge },\n   ];\n }\n ",
      "previousPath": null
    },
    {
      "path": "test/billing/invoice.test.ts",
