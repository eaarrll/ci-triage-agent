  "changedFiles": [
    {
      "path": "package.json",
      "status": "modified",
      "additions": 2,
      "deletions": 1,
      "patch": "@@ -19,7 +19,8 @@\n     \"@fastify/sensible\": \"^6.0.1\",\n     \"fastify\": \"^5.2.0\",\n     \"pino\": \"^9.5.0\",\n-    \"undici\": \"^7.2.0\"\n+    \"undici\": \"^7.2.0\",\n+    \"zod\": \"^3.24.1\"\n   },\n   \"devDependencies\": {\n     \"@eslint/js\": \"^9.17.0\",",
      "previousPath": null
    },
    {
      "path": "src/handlers/webhook.ts",
      "status": "modified",
      "additions": 9,
      "deletions": 17,
      "patch": "@@ -1,25 +1,17 @@\n import type { FastifyInstance } from \"fastify\";\n import { dispatch } from \"../channels/index.js\";\n+import { webhookBodySchema } from \"../schemas/webhook.js\";\n \n-interface WebhookBody {\n-  event: string;\n-  template: string;\n-  recipient: { email?: string; slackChannel?: string };\n-  data?: Record<string, unknown>;\n-}\n-\n export async function webhookRoutes(app: FastifyInstance): Promise<void> {\n-  app.post<{ Body: WebhookBody }>(\"/v1/webhooks/notify\", async (request, reply) => {\n-    const body = request.body;\n-    if (!body?.event || !body.template || (!body.recipient?.email && !body.recipient?.slackChannel)) {\n-      return reply.badRequest(\"event, template and a recipient are required\");\n+  app.post(\"/v1/webhooks/notify\", async (request, reply) => {\n+    const parsed = webhookBodySchema.safeParse(request.body);\n+    if (!parsed.success) {\n+      return reply.code(400).send({\n+        error: \"invalid_payload\",\n+        issues: parsed.error.issues.map((i) => ({ path: i.path.join(\".\"), message: i.message })),\n+      });\n     }\n-    const id = await dispatch({\n-      event: body.event,\n-      template: body.template,\n-      recipient: body.recipient,\n-      data: body.data ?? {},\n-    });\n+    const id = await dispatch(parsed.data);\n     return reply.code(202).send({ id });\n   });\n }",
      "previousPath": null
    },
    {
      "path": "src/schemas/webhook.ts",
      "status": "added",
      "additions": 22,
      "deletions": 0,
      "patch": "@@ -0,0 +1,22 @@\n+import { z } from \"zod\";\n+\n+const recipientSchema = z\n+  .object({\n+    email: z.string().email().optional(),\n+    slackChannel: z\n+      .string()\n+      .regex(/^#[a-z0-9_-]{1,80}$/)\n+      .optional(),\n+  })\n+  .refine((r) => r.email !== undefined || r.slackChannel !== undefined, {\n+    message: \"recipient needs an email or a slackChannel\",\n+  });\n+\n+export const webhookBodySchema = z.object({\n+  event: z.string().min(1).max(64),\n+  template: z.string().min(1),\n+  recipient: recipientSchema,\n+  data: z.record(z.unknown()).default({}),\n+});\n+\n+export type WebhookBody = z.infer<typeof webhookBodySchema>;",
      "previousPath": null
    },
    {
      "path": "test/webhook.test.ts",
      "status": "modified",
      "additions": 11,
      "deletions": 0,
      "patch": "@@ -25,5 +25,16 @@\n       payload: { event: \"invoice.paid\", template: \"receipt\", recipient: {} },\n     });\n     expect(res.statusCode).toBe(400);\n+    expect(res.json().error).toBe(\"invalid_payload\");\n   });\n+\n+  it(\"reports the offending field for a malformed email\", async () => {\n+    const res = await app.inject({\n+      method: \"POST\",\n+      url: \"/v1/webhooks/notify\",\n+      payload: { event: \"invoice.paid\", template: \"receipt\", recipient: { email: \"not-an-email\" } },\n+    });\n+    expect(res.statusCode).toBe(400);\n+    expect(res.json().issues).toContainEqual(expect.objectContaining({ path: \"recipient.email\" }));\n+  });\n });",
      "previousPath": null
    }
  ],
