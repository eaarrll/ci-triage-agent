      "deletions": 0,
      "patch": "@@ -0,0 +1,3 @@\n+alter table users add column phone text unique;\n+alter table users alter column email drop not null;\n+alter table users add constraint users_email_or_phone check (email is not null or phone is not null);",
      "previousPath": null
    },
