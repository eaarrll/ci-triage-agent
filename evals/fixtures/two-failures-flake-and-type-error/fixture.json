      "path": "src/routes/signup.ts",
      "status": "modified",
      "additions": 13,
      "deletions": 6,
      "patch": "@@ -2,18 +2,25 @@\n import { z } from \"zod\";\n import { createUser } from \"../db/users.js\";\n import { sendWelcome } from \"../mailer/templates/welcome.js\";\n+import { sendWelcomeSms } from \"../sms/welcome.js\";\n \n-const body = z.object({\n-  email: z.string().email(),\n-  displayName: z.string().min(1).max(80),\n-  locale: z.string().optional(),\n-});\n+const body = z\n+  .object({\n+    email: z.string().email().optional(),\n+    phone: z.string().regex(/^\\+[1-9]\\d{6,14}$/).optional(),\n+    displayName: z.string().min(1).max(80),\n+    locale: z.string().optional(),\n+  })\n+  .refine((input) => input.email !== undefined || input.phone !== undefined, {\n+    message: \"email or phone is required\",\n+  });\n \n export async function signupRoutes(app: FastifyInstance): Promise<void> {\n   app.post(\"/v1/signup\", async (request, reply) => {\n     const input = body.parse(request.body);\n     const user = await createUser(input);\n-    await sendWelcome(user);\n+    if (user.email) await sendWelcome(user);\n+    else await sendWelcomeSms(user);\n     return reply.code(201).send({ id: user.id });\n   });\n }",
      "previousPath": null
    },
    {
      "path": "src/sms/welcome.ts",
      "status": "added",
      "additions": 7,
      "deletions": 0,
      "patch": "@@ -0,0 +1,7 @@\n+import type { User } from \"../models/user.js\";\n+import { smsProvider } from \"./provider.js\";\n+\n+export async function sendWelcomeSms(user: User): Promise<void> {\n+  if (!user.phone) return;\n+  await smsProvider().send(user.phone, `Welcome to Acme, ${user.displayName}!`);\n+}",
      "previousPath": null
    },
