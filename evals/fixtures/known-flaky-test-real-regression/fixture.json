  "changedFiles": [
    {
      "path": "internal/ws/config.go",
      "status": "modified",
      "additions": 21,
      "deletions": 4,
      "patch": "@@ -1,6 +1,10 @@\n package ws\n \n-import \"time\"\n+import (\n+\t\"os\"\n+\t\"strconv\"\n+\t\"time\"\n+)\n \n // Config controls how a Client connects to the upstream hub.\n type Config struct {\n@@ -10,12 +14,25 @@\n \tPingInterval  time.Duration\n }\n \n-// DefaultConfig returns the settings used in production.\n+// DefaultConfig returns the settings used in production. The reconnect backoff can be tuned\n+// per deployment with WS_RECONNECT_BASE_MS and WS_RECONNECT_MAX_MS.\n func DefaultConfig(url string) Config {\n \treturn Config{\n \t\tURL:           url,\n-\t\tReconnectBase: 250 * time.Millisecond,\n-\t\tReconnectMax:  30 * time.Second,\n+\t\tReconnectBase: envDuration(\"WS_RECONNECT_BASE_MS\", 250, time.Second),\n+\t\tReconnectMax:  envDuration(\"WS_RECONNECT_MAX_MS\", 30_000, time.Millisecond),\n \t\tPingInterval:  20 * time.Second,\n \t}\n }\n+\n+// envDuration reads a positive integer from the environment (def when unset or invalid) and\n+// scales it by unit.\n+func envDuration(key string, def int64, unit time.Duration) time.Duration {\n+\tn := def\n+\tif raw, ok := os.LookupEnv(key); ok {\n+\t\tif parsed, err := strconv.ParseInt(raw, 10, 64); err == nil && parsed > 0 {\n+\t\t\tn = parsed\n+\t\t}\n+\t}\n+\treturn time.Duration(n) * unit\n+}",
      "previousPath": null
    },
    {
      "path": "internal/ws/config_test.go",
      "status": "added",
      "additions": 20,
      "deletions": 0,
      "patch": "@@ -0,0 +1,20 @@\n+package ws\n+\n+import (\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+func TestDefaultConfigReadsMaxFromEnv(t *testing.T) {\n+\tt.Setenv(\"WS_RECONNECT_MAX_MS\", \"5000\")\n+\tif got := DefaultConfig(\"ws://hub\").ReconnectMax; got != 5*time.Second {\n+\t\tt.Fatalf(\"ReconnectMax = %s, want 5s\", got)\n+\t}\n+}\n+\n+func TestDefaultConfigIgnoresInvalidValues(t *testing.T) {\n+\tt.Setenv(\"WS_RECONNECT_MAX_MS\", \"soon\")\n+\tif got := DefaultConfig(\"ws://hub\").ReconnectMax; got != 30*time.Second {\n+\t\tt.Fatalf(\"ReconnectMax = %s, want 30s\", got)\n+\t}\n+}",
      "previousPath": null
    },
