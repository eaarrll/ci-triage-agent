  "changedFiles": [
    {
      "path": "CHANGELOG.md",
      "status": "modified",
      "additions": 3,
      "deletions": 0,
      "patch": "@@ -2,6 +2,9 @@\n \n ## Unreleased\n \n+- Retry backoff now applies proportional jitter (`RetryPolicy.jitter`, default 0.2) so clients that\n+  failed together do not retry in lockstep.\n+\n ## 2.4.0 - 2026-11-03\n \n - Added `Client.projects.archive()`.",
      "previousPath": null
    },
    {
      "path": "docs/retries.md",
      "status": "modified",
      "additions": 4,
      "deletions": 2,
      "patch": "@@ -4,10 +4,12 @@\n `RetryPolicy.max_attempts` (default 4) attempts in total.\n \n Between attempts it waits `base_delay * 2 ** (attempt - 1)` seconds, capped at `max_delay`, unless\n-the server sent `Retry-After`, which always wins.\n+the server sent `Retry-After`, which always wins. The computed delay is then spread by\n+`+/- jitter` (a fraction, default `0.2`) so many clients that failed at the same moment do not all\n+retry at the same moment. Set `jitter=0` for deterministic delays.\n \n ```python\n from acme_sdk import Client, RetryPolicy\n \n-client = Client(api_key=\"...\", retry=RetryPolicy(max_attempts=6, max_delay=30))\n+client = Client(api_key=\"...\", retry=RetryPolicy(max_attempts=6, max_delay=30, jitter=0.1))\n ```",
      "previousPath": null
    },
    {
      "path": "src/acme_sdk/_http.py",
      "status": "modified",
      "additions": 9,
      "deletions": 3,
      "patch": "@@ -2,6 +2,7 @@\n \n from __future__ import annotations\n \n+import random\n import time\n from dataclasses import dataclass\n from typing import Any\n@@ -18,10 +19,15 @@\n     max_attempts: int = 4\n     base_delay: float = 0.5\n     max_delay: float = 8.0\n+    jitter: float = 0.2\n \n-    def delay(self, attempt: int) -> float:\n-        \"\"\"Exponential backoff for the given 1-based attempt.\"\"\"\n-        return min(self.max_delay, self.base_delay * 2 ** (attempt - 1))\n+    def delay(self, attempt: int, *, rng: random.Random | None = None) -> float:\n+        \"\"\"Exponential backoff for the given 1-based attempt, +/- `jitter` as a fraction.\"\"\"\n+        raw = min(self.max_delay, self.base_delay * 2 ** (attempt - 1))\n+        if not self.jitter:\n+            return raw\n+        spread = (rng or random).uniform(-self.jitter, self.jitter)\n+        return max(0.0, raw * (1 + spread))\n \n \n class Transport:",
      "previousPath": null
    },
    {
      "path": "tests/test_http.py",
      "status": "modified",
      "additions": 13,
      "deletions": 1,
      "patch": "@@ -1,3 +1,5 @@\n+import random\n+\n import httpx\n import pytest\n \n@@ -6,9 +8,19 @@\n \n @pytest.mark.parametrize((\"attempt\", \"expected\"), [(1, 0.5), (2, 1.0), (3, 2.0), (5, 8.0), (9, 8.0)])\n def test_backoff_is_exponential_and_capped(attempt, expected):\n-    assert RetryPolicy().delay(attempt) == expected\n+    assert RetryPolicy(jitter=0).delay(attempt) == expected\n \n \n+@pytest.mark.parametrize(\"attempt\", [1, 2, 3, 4, 6])\n+def test_jitter_stays_within_bounds(attempt):\n+    policy = RetryPolicy(jitter=0.2)\n+    raw = RetryPolicy(jitter=0).delay(attempt)\n+    rng = random.Random(1234)\n+    delays = [policy.delay(attempt, rng=rng) for _ in range(200)]\n+    assert all(raw * 0.8 <= d <= raw * 1.2 for d in delays)\n+    assert len(set(delays)) > 1\n+\n+\n def test_retries_5xx_then_succeeds(api, client):\n     route = api.get(\"/projects\").mock(\n         side_effect=[httpx.Response(503), httpx.Response(200, json={\"data\": [], \"next_cursor\": None})]",
      "previousPath": null
    }
