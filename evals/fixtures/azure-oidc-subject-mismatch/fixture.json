      "patch": "@@ -32,6 +32,7 @@ jobs:\n     name: Deploy to production\n     needs: build\n     runs-on: ubuntu-24.04\n+    environment: production\n     steps:\n       - uses: actions/checkout@v4\n       - uses: docker/setup-buildx-action@v3",
