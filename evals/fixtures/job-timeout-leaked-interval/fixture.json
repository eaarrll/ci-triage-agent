  "changedFiles": [
    {
      "path": "src/metrics/batcher.ts",
      "status": "added",
      "additions": 40,
      "deletions": 0,
      "patch": "@@ -0,0 +1,40 @@\n+export interface MetricsSink {\n+  send(lines: string[]): Promise<void>;\n+}\n+\n+export interface BatcherOptions {\n+  flushIntervalMs: number;\n+  sink: MetricsSink;\n+  prefix?: string;\n+}\n+\n+/**\n+ * Buffers counters in memory and sends them in one batch per interval, instead of one UDP packet per\n+ * event. At peak we handle ~4k events/s, which was saturating the StatsD agent.\n+ */\n+export class MetricsBatcher {\n+  private readonly counters = new Map<string, number>();\n+  private readonly timer: NodeJS.Timeout;\n+\n+  constructor(private readonly opts: BatcherOptions) {\n+    this.timer = setInterval(() => void this.flush(), opts.flushIntervalMs);\n+  }\n+\n+  increment(name: string, by = 1): void {\n+    const key = `${this.opts.prefix ?? \"\"}${name}`;\n+    this.counters.set(key, (this.counters.get(key) ?? 0) + by);\n+  }\n+\n+  async flush(): Promise<void> {\n+    if (this.counters.size === 0) return;\n+    const lines = [...this.counters].map(([key, value]) => `${key}:${value}|c`);\n+    this.counters.clear();\n+    await this.opts.sink.send(lines);\n+  }\n+\n+  /** Sends what is buffered and stops the timer. Call on shutdown. */\n+  async stop(): Promise<void> {\n+    clearInterval(this.timer);\n+    await this.flush();\n+  }\n+}",
      "previousPath": null
    },
    {
      "path": "src/metrics/index.ts",
      "status": "added",
      "additions": 9,
      "deletions": 0,
      "patch": "@@ -0,0 +1,9 @@\n+import { MetricsBatcher } from \"./batcher\";\n+import { statsdSink } from \"./statsd\";\n+\n+/** Process-wide counters, flushed every 10 seconds. */\n+export const metrics = new MetricsBatcher({\n+  flushIntervalMs: 10_000,\n+  sink: statsdSink(process.env.STATSD_HOST ?? \"127.0.0.1\", Number(process.env.STATSD_PORT ?? 8125)),\n+  prefix: \"events_worker.\",\n+});",
      "previousPath": null
    },
    {
      "path": "src/metrics/statsd.ts",
      "status": "added",
      "additions": 11,
      "deletions": 0,
      "patch": "@@ -0,0 +1,11 @@\n+import { createSocket } from \"node:dgram\";\n+import type { MetricsSink } from \"./batcher\";\n+\n+export function statsdSink(host: string, port: number): MetricsSink {\n+  const socket = createSocket(\"udp4\");\n+  socket.unref();\n+  return {\n+    send: (lines) =>\n+      new Promise((resolve) => socket.send(lines.join(\"\\n\"), port, host, () => resolve())),\n+  };\n+}",
      "previousPath": null
    },
