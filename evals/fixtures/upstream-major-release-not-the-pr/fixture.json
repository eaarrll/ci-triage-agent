      "path": "src/reportcli/export.py",
      "status": "modified",
      "additions": 11,
      "deletions": 3,
      "patch": "@@ -3,7 +3,8 @@\n from __future__ import annotations\n \n import json\n-from collections.abc import Iterable\n+from collections.abc import Iterable, Iterator\n+from datetime import date\n from typing import IO\n \n import csvforge\n@@ -13,9 +14,16 @@\n COLUMNS = [\"date\", \"account\", \"category\", \"amount\", \"currency\"]\n \n \n-def write_report(rows: Iterable[Row], out: IO[str], fmt: str = \"csv\") -> int:\n+def filter_since(rows: Iterable[Row], since: date | None) -> Iterator[Row]:\n+    \"\"\"Rows dated on or after `since`; every row when it is None.\"\"\"\n+    for row in rows:\n+        if since is None or row.date >= since:\n+            yield row\n+\n+\n+def write_report(rows: Iterable[Row], out: IO[str], fmt: str = \"csv\", since: date | None = None) -> int:\n     \"\"\"Writes rows to out and returns how many were written.\"\"\"\n-    rows = list(rows)\n+    rows = list(filter_since(rows, since))\n     if fmt == \"json\":\n         json.dump([row.as_dict() for row in rows], out, indent=2, default=str)\n     elif fmt == \"csv\":",
      "previousPath": null
    },
    {
      "path": "src/reportcli/cli.py",
      "status": "modified",
      "additions": 3,
      "deletions": 2,
      "patch": "@@ -17,9 +17,10 @@\n @click.argument(\"report\")\n @click.option(\"--format\", \"fmt\", type=click.Choice([\"csv\", \"json\"]), default=\"csv\", show_default=True)\n @click.option(\"--output\", \"-o\", type=click.File(\"w\"), default=\"-\")\n-def export(report: str, fmt: str, output) -> None:\n+@click.option(\"--since\", type=click.DateTime([\"%Y-%m-%d\"]), default=None, help=\"Only rows on or after this date.\")\n+def export(report: str, fmt: str, output, since) -> None:\n     \"\"\"Export REPORT (e.g. monthly-spend) to a file or stdout.\"\"\"\n-    count = write_report(fetch_rows(report), output, fmt)\n+    count = write_report(fetch_rows(report), output, fmt, since.date() if since else None)\n     click.echo(f\"wrote {count} rows\", err=True)\n \n ",
      "previousPath": null
    },
