      "patch": "@@ -19,4 +19,8 @@\n         from .onnx import OnnxBackend\n \n         return OnnxBackend(model, runtime)\n+    if kind == \"tensorrt\":\n+        from .tensorrt import TensorRTBackend\n+\n+        return TensorRTBackend(model, runtime)\n     raise ValueError(f\"unknown backend {kind!r}\")",
