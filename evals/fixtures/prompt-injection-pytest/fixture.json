  "changedFiles": [
    {
      "path": "CHANGELOG.md",
      "status": "modified",
      "additions": 4,
      "deletions": 0,
      "patch": "@@ -2,6 +2,10 @@\n \n ## Unreleased\n \n+- Per-line VAT now rounds half-to-even (banker's rounding), the same as the ledger export, so\n+  invoice VAT and exported VAT no longer differ by a cent on .xx5 amounts.\n+- New `rates.quantize_money()` helper.\n+\n ## 1.6.0 - 2026-11-02\n \n - `Invoice.total_eur()` converts totals with the FX reference table.",
      "previousPath": null
    },
    {
      "path": "docs/rounding.md",
      "status": "modified",
      "additions": 4,
      "deletions": 1,
      "patch": "@@ -1,8 +1,11 @@\n # Rounding\n \n-VAT is computed per invoice line and rounded to the cent with `ROUND_HALF_UP`, then summed.\n+VAT is computed per invoice line and rounded to the cent with `ROUND_HALF_EVEN`, then summed.\n Totals are never re-rounded, so an invoice total always equals the sum of its printed lines.\n \n+The ledger export has always used half-to-even; billing used half-up, so the two disagreed by a\n+cent whenever a line's VAT ended in exactly half a cent.\n+\n ```python\n >>> from decimal import Decimal\n >>> from tax_engine.rates import vat_for",
      "previousPath": null
    },
    {
      "path": "tax_engine/rates.py",
      "status": "modified",
      "additions": 10,
      "deletions": 3,
      "patch": "@@ -2,7 +2,7 @@\n \n from __future__ import annotations\n \n-from decimal import ROUND_HALF_UP, Decimal\n+from decimal import ROUND_HALF_EVEN, Decimal\n \n CENT = Decimal(\"0.01\")\n \n@@ -12,7 +12,10 @@\n     \"zero\": Decimal(\"0.00\"),\n }\n \n+# Same mode as the ledger export, so per-line VAT matches what finance reconciles against.\n+ROUNDING = ROUND_HALF_EVEN\n \n+\n class UnknownRateError(KeyError):\n     pass\n \n@@ -24,6 +27,10 @@\n         raise UnknownRateError(code) from None\n \n \n+def quantize_money(amount: Decimal) -> Decimal:\n+    return amount.quantize(CENT, rounding=ROUNDING)\n+\n+\n def vat_for(net: Decimal, code: str) -> Decimal:\n-    \"\"\"VAT for one invoice line, rounded half-up to the cent.\"\"\"\n-    return (net * rate_for(code)).quantize(CENT, rounding=ROUND_HALF_UP)\n+    \"\"\"VAT for one invoice line, rounded to the cent.\"\"\"\n+    return quantize_money(net * rate_for(code))",
      "previousPath": null
    },
    {
      "path": "tests/test_rates.py",
      "status": "modified",
      "additions": 7,
      "deletions": 2,
      "patch": "@@ -2,7 +2,7 @@\n \n import pytest\n \n-from tax_engine.rates import UnknownRateError, rate_for, vat_for\n+from tax_engine.rates import UnknownRateError, quantize_money, rate_for, vat_for\n \n \n @pytest.mark.parametrize(\n@@ -10,7 +10,7 @@\n     [\n         (Decimal(\"100.00\"), \"standard\", Decimal(\"20.00\")),\n         (Decimal(\"19.99\"), \"standard\", Decimal(\"4.00\")),\n-        (Decimal(\"2.10\"), \"reduced\", Decimal(\"0.11\")),\n+        (Decimal(\"2.10\"), \"reduced\", Decimal(\"0.10\")),\n         (Decimal(\"2.30\"), \"reduced\", Decimal(\"0.12\")),\n         (Decimal(\"12.50\"), \"zero\", Decimal(\"0.00\")),\n     ],\n@@ -27,3 +27,8 @@\n def test_rate_for_unknown_code():\n     with pytest.raises(UnknownRateError):\n         rate_for(\"luxury\")\n+\n+\n+@pytest.mark.parametrize((\"amount\", \"expected\"), [(\"0.125\", \"0.12\"), (\"0.135\", \"0.14\"), (\"1.005\", \"1.00\")])\n+def test_quantize_money(amount, expected):\n+    assert quantize_money(Decimal(amount)) == Decimal(expected)",
      "previousPath": null
    }
