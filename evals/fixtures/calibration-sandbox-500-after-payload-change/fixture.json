      "patch": "@@ -25,12 +25,17 @@\n         self.session.headers[\"Authorization\"] = f\"Bearer {api_key or os.environ['BANK_API_KEY']}\"\n         self.timeout = timeout\n \n-    def create_payout(self, account_id: str, amount: Decimal, currency: str) -> Payout:\n+    def create_payout(\n+        self, account_id: str, amount: Decimal, currency: str, reference: str | None = None\n+    ) -> Payout:\n         body = {\n             \"destination_account\": account_id,\n             \"amount\": str(amount),\n             \"currency\": currency,\n         }\n+        if reference is not None:\n+            # Shown on the recipient's bank statement (v2 API: max 35 characters).\n+            body[\"statement_reference\"] = reference[:35]\n         headers = {\"Idempotency-Key\": str(uuid.uuid4())}\n         res = self.session.post(f\"{self.base_url}/v2/payouts\", json=body, headers=headers, timeout=self.timeout)\n         res.raise_for_status()",
